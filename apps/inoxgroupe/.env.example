# URL du projet Supabase partagé par les applications INOX en production.
SUPABASE_URL=https://votre-projet.supabase.co

# Clé serveur moderne sb_secret_... Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_votre_cle_serveur

# Compatibilité de migration : l’application accepte encore temporairement
# inoxstorage_SUPABASE_URL et inoxstorage_SUPABASE_SECRET_KEY.

# Secret aléatoire long, utilisé uniquement pour limiter les abus sans stocker les IP.
FORUM_HASH_SECRET=remplacez-par-un-secret-aleatoire-de-32-caracteres-ou-plus

# Clé serveur Groq pour l’assistant. Ne jamais préfixer par NEXT_PUBLIC_.
GROQ_API_KEY=gsk_votre_cle_groq

# Secret distinct recommandé pour isoler les conversations publiques par site.
AI_SESSION_SECRET=remplacez-par-un-secret-aleatoire-de-32-caracteres-ou-plus
