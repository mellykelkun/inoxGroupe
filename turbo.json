{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["packages/assistant-links.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "GROQ_API_KEY",
        "AI_SESSION_SECRET",
        "FORUM_HASH_SECRET",
        "CONTACT_HASH_SECRET",
        "ADMIN_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "inoxstorage_SUPABASE_URL",
        "inoxstorage_SUPABASE_PUBLISHABLE_KEY",
        "inoxstorage_SUPABASE_ANON_KEY",
        "inoxstorage_SUPABASE_SECRET_KEY",
        "inoxstorage_SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".next/types/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
