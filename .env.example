# URL du projet Supabase partagé par le site public et le futur site admin.
SUPABASE_URL=https://votre-projet.supabase.co

# Clé serveur moderne sb_secret_... Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_votre_cle_serveur

# Avec l’intégration Supabase de Vercel, l’application accepte aussi :
# inoxstorage_SUPABASE_URL et inoxstorage_SUPABASE_SECRET_KEY.

# Secret aléatoire long, utilisé uniquement pour limiter les abus sans stocker les IP.
FORUM_HASH_SECRET=remplacez-par-un-secret-aleatoire-de-32-caracteres-ou-plus
